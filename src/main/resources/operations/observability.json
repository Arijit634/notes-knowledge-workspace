{
  "format": "oci-console-monitoring-plan-1",
  "namespace": "notes_workspace",
  "scrape": {"url": "http://127.0.0.1:8081/actuator/prometheus", "intervalSeconds": 60, "public": false},
  "limits": {"additionalMonthlySpend": 0, "maximumCustomSeries": 10000, "physicalLogRetentionDays": 30, "operationalLogTargetDays": 14, "logRetentionApprovalRequired": true},
  "events": ["application.start", "application.ready", "application.shutdown", "request.completed", "security.control.rejected", "dependency.state_change", "auth.outcome", "note.command.outcome", "attachment.validation.outcome", "storage.operation.outcome", "knowledge.work.outcome", "retrieval.outcome", "ai.provider.outcome", "security_email.work.outcome", "publication.command.outcome", "public_denial.outcome", "moderation.outcome"],
  "applicationSignals": {
    "uptime": {"meter": "process.uptime", "query": "process_uptime_seconds[1m].max()"},
    "inflight": {"meter": "notes.workspace.http.inflight", "query": "notes_workspace_http_inflight[1m].max()"},
    "http": {"meter": "http.server.requests", "query": "http_server_requests_seconds_count[1m].rate()"},
    "heap": {"meter": "jvm.memory.used", "query": "jvm_memory_used_bytes[1m]{area=\"heap\"}.sum()"},
    "threads": {"meter": "jvm.threads.live", "query": "jvm_threads_live_threads[1m].max()"},
    "pool": {"meter": "hikaricp.connections.active", "query": "hikaricp_connections_active[1m].max()"},
    "database": {"meter": "notes.workspace.db.operation", "query": "notes_workspace_db_operation_seconds_count[1m].rate()"},
    "dependency": {"meter": "notes.workspace.dependency.available", "query": "notes_workspace_dependency_available[1m].min()"},
    "redis": {"meter": "notes.workspace.redis.operation", "query": "notes_workspace_redis_operation_seconds_count[1m].rate()"},
    "rateControl": {"meter": "notes.workspace.rate_control", "query": "notes_workspace_rate_control_total[1m].rate()"},
    "knowledgeAge": {"meter": "notes.workspace.knowledge.work.oldest_age", "query": "notes_workspace_knowledge_work_oldest_age[1m]{eligibility=\"due\"}.max()"},
    "knowledgeWork": {"meter": "notes.workspace.knowledge.work.outcome", "query": "notes_workspace_knowledge_work_outcome_total[15m].increment()"},
    "knowledgeCount": {"meter": "notes.workspace.knowledge.work.count", "query": "notes_workspace_knowledge_work_count[1m].max()"},
    "emailAge": {"meter": "notes.workspace.security_email.oldest_ready_age", "query": "notes_workspace_security_email_oldest_ready_age[1m]{eligibility=\"due\"}.max()"},
    "emailWork": {"meter": "notes.workspace.security_email.outcome", "query": "notes_workspace_security_email_outcome_total[15m].increment()"},
    "emailCount": {"meter": "notes.workspace.security_email.work.count", "query": "notes_workspace_security_email_work_count[1m].max()"},
    "search": {"meter": "notes.workspace.search.request", "query": "notes_workspace_search_request_seconds_count[1m].rate()"},
    "preGeneration": {"meter": "notes.workspace.retrieval.pre_generation", "query": "notes_workspace_retrieval_pre_generation_seconds[1m]{quantile=\"0.95\"}.max()"},
    "candidates": {"meter": "notes.workspace.retrieval.candidates", "query": "notes_workspace_retrieval_candidates_sum[1m].increment()"},
    "coverage": {"meter": "notes.workspace.retrieval.coverage", "query": "notes_workspace_retrieval_coverage[1m].mean()"},
    "provider": {"meter": "notes.workspace.ai.provider", "query": "notes_workspace_ai_provider_seconds_count[15m].increment()"},
    "validation": {"meter": "notes.workspace.attachment.validation", "query": "notes_workspace_attachment_validation_seconds_count[1m].rate()"},
    "storage": {"meter": "notes.workspace.storage.operation", "query": "notes_workspace_storage_operation_seconds_count[10m].increment()"},
    "auth": {"meter": "notes.workspace.identity.auth", "query": "notes_workspace_identity_auth_total[1m].rate()"},
    "rejections": {"meter": "notes.workspace.security.control_rejected", "query": "notes_workspace_security_control_rejected_total[1m].rate()"},
    "publication": {"meter": "notes.workspace.publication.command", "query": "notes_workspace_publication_command_total[1m].rate()"},
    "publicDenial": {"meter": "notes.workspace.public.denial", "query": "notes_workspace_public_denial_total[1m].rate()"},
    "moderation": {"meter": "notes.workspace.moderation.command", "query": "notes_workspace_moderation_command_total[1m].rate()"},
    "telemetry": {"meter": "notes.workspace.telemetry.available", "query": "notes_workspace_telemetry_available[1m].min()"}
  },
  "operatorSignals": {
    "availability": "External synthetic: required vantage failures, two consecutive probes, two-success recovery; no private payload",
    "readiness": "Loopback readiness status observation; never scrape detailed health publicly",
    "coreFailureRatio": "Core non-AI allowlisted route 5xx ratio, minimum traffic; short and long windows",
    "coreLatency": "Core non-AI allowlisted route single-replica p95 seconds; never percentile of counter samples",
    "restarts": "Host process supervisor restart count and missing-process signal",
    "disk": "Host disk/inode free ratio and 24-hour capacity projection",
    "memory": "Post-GC heap pressure, available host memory, OOM signal",
    "poolPressure": "Hikari active/max ratio AND pending requests",
    "knowledgeFailureBaseline": "Terminal/reclaim rate against measured seven-day same-hour baseline, minimum five events",
    "stagingAge": "Owner-module object reconciliation evidence; no object key, filename or private data",
    "quota": "Dated verified free model limits, local soft budget or safe RESOURCE_EXHAUSTED evidence; never invented remaining quota",
    "tls": "External hostname/certificate verification and remaining validity seconds",
    "capacity": "Verified compute/block/object/log/metric/synthetic/notification/outbound free allowance ratios",
    "backupAge": "Age of authenticated AND restore-rehearsed encrypted backup evidence, approved interval required",
    "metricHeartbeat": "Independent OCI ingestion heartbeat plus successful service probe",
    "logHeartbeat": "Independent OCI log ingestion heartbeat and bounded local buffer usage",
    "securityInvariant": "Zero-tolerance semantic acceptance/probe violation, NOT normal blocked access attempts",
    "denialInvariant": "Anonymous content/media success after committed logical denial, NOT successful expected 404",
    "emailInvariant": "Security-email authority/material/fence corruption, NOT normal stale claim rejection",
    "moderationInvariant": "Committed terminal enforcement without required consequence/current-session denial",
    "release": "Immutable artifact/source annotation; not a metric dimension"
  },
  "dashboards": [
    {"id":1,"name":"System Overview","signals":["availability","readiness","uptime","inflight","dependency","restarts","disk","tls","release"]},
    {"id":2,"name":"HTTP and API","signals":["http","coreFailureRatio","coreLatency","inflight","rejections"]},
    {"id":3,"name":"JVM Database and Redis","signals":["heap","threads","memory","pool","poolPressure","database","redis","disk"]},
    {"id":4,"name":"Knowledge AI and Retrieval","signals":["knowledgeAge","knowledgeWork","knowledgeCount","search","preGeneration","candidates","coverage","provider","quota"]},
    {"id":5,"name":"Identity and Security Delivery","signals":["auth","rejections","rateControl","emailAge","emailWork","emailCount","moderation","securityInvariant","emailInvariant","moderationInvariant"]},
    {"id":6,"name":"Storage and Publication","signals":["validation","storage","stagingAge","publication","publicDenial","denialInvariant"]},
    {"id":7,"name":"Capacity Cost and Release","signals":["capacity","quota","backupAge","metricHeartbeat","logHeartbeat","telemetry","release"]}
  ],
  "alerts": [
    {"id":1,"name":"External service unavailable","signal":"availability","condition":"two consecutive required-vantage failures","pending":"PT12M","severity":"CRITICAL","runbook":"tls-dns-or-host","recovery":"two successful probes","maintenanceAllowed":true},
    {"id":2,"name":"Application not ready","signal":"readiness","condition":"readiness down","pending":"PT5M","severity":"CRITICAL","runbook":"failed-deployment-or-database","recovery":"ready for five minutes","maintenanceAllowed":true},
    {"id":3,"name":"PostgreSQL unavailable","signal":"dependency","query":"notes_workspace_dependency_available[1m]{dependency=\"postgresql\"}.min() < 1","pending":"PT2M","severity":"CRITICAL","runbook":"postgresql-outage","recovery":"database available for five minutes","maintenanceAllowed":true},
    {"id":4,"name":"Sustained core failures","signal":"coreFailureRatio","condition":"over five percent for five minutes OR one percent for thirty minutes with reviewed minimum traffic","pending":"PT5M","severity":"ERROR","runbook":"failed-deployment-or-rollback","recovery":"below thresholds for fifteen minutes","maintenanceAllowed":true},
    {"id":5,"name":"Core API latency","signal":"coreLatency","condition":"p95 over 0.75 seconds; high over 1.5 seconds","pending":"PT15M","severity":"WARNING","runbook":"database-or-rollback","recovery":"below target for fifteen minutes","maintenanceAllowed":true},
    {"id":6,"name":"Restart or crash loop","signal":"restarts","condition":"three restarts within fifteen minutes OR process missing","pending":"PT1M","severity":"CRITICAL","runbook":"failed-deployment-or-host","recovery":"stable for thirty minutes","maintenanceAllowed":true},
    {"id":7,"name":"Disk or inode low","signal":"disk","condition":"free below fifteen percent; high below eight percent OR projection below twenty four hours","pending":"PT10M","severity":"WARNING","runbook":"host-storage-recovery","recovery":"free over twenty percent","maintenanceAllowed":false},
    {"id":8,"name":"Memory pressure","signal":"memory","condition":"post-GC heap over eighty five percent OR host free below ten percent; OOM critical","pending":"PT15M","severity":"ERROR","runbook":"deployment-or-rollback","recovery":"stable for thirty minutes","maintenanceAllowed":true},
    {"id":9,"name":"Database pool saturated","signal":"poolPressure","condition":"active/max over 0.85 AND pending over zero","pending":"PT10M","severity":"ERROR","runbook":"postgresql-outage","recovery":"ratio below 0.70 for fifteen minutes","maintenanceAllowed":true},
    {"id":10,"name":"Redis control unavailable","signal":"rateControl","query":"notes_workspace_rate_control_total[5m]{outcome=\"unavailable\"}.increment() > 0","pending":"PT5M","severity":"ERROR","runbook":"redis-outage","recovery":"controls available for ten minutes","maintenanceAllowed":false},
    {"id":11,"name":"Knowledge backlog age","signal":"knowledgeAge","query":"notes_workspace_knowledge_work_oldest_age[1m]{eligibility=\"due\"}.max() > 600","overrides":[{"ruleName":"high","query":"notes_workspace_knowledge_work_oldest_age[1m]{eligibility=\"due\"}.max() > 1800","severity":"ERROR","pendingDuration":"PT1M"}],"pending":"PT1M","severity":"WARNING","runbook":"stuck-knowledge-work","recovery":"due backlog age below three hundred seconds","maintenanceAllowed":false},
    {"id":12,"name":"Knowledge failure or reclaim spike","signal":"knowledgeFailureBaseline","condition":"over three times measured same-hour seven-day baseline with at least five events in fifteen minutes","pending":"PT15M","severity":"ERROR","runbook":"stuck-knowledge-work","recovery":"normal for thirty minutes","maintenanceAllowed":true},
    {"id":13,"name":"Security email backlog age","signal":"emailAge","query":"notes_workspace_security_email_oldest_ready_age[1m]{eligibility=\"due\"}.max() > 300","overrides":[{"ruleName":"high","query":"notes_workspace_security_email_oldest_ready_age[1m]{eligibility=\"due\"}.max() > 900","severity":"ERROR","pendingDuration":"PT1M"}],"pending":"PT1M","severity":"WARNING","runbook":"stuck-security-email","recovery":"due backlog below one hundred twenty seconds","maintenanceAllowed":false},
    {"id":14,"name":"Security email terminal failures","signal":"emailWork","query":"notes_workspace_security_email_outcome_total[15m]{outcome=\"failed\"}.grouping().increment() >= 3 || notes_workspace_security_email_outcome_total[15m]{outcome=\"failed\"}.grouping().increment() / (notes_workspace_security_email_outcome_total[15m]{outcome=\"success\"}.grouping().increment() + notes_workspace_security_email_outcome_total[15m]{outcome=\"failed\"}.grouping().increment()) > 0.05","pending":"PT1M","severity":"ERROR","runbook":"stuck-security-email","recovery":"stable for thirty minutes","maintenanceAllowed":false},
    {"id":15,"name":"Object storage failures","signal":"storage","query":"notes_workspace_storage_operation_seconds_count[10m].grouping().increment() >= 5 && notes_workspace_storage_operation_seconds_count[10m]{outcome=\"unavailable\"}.grouping().increment() / notes_workspace_storage_operation_seconds_count[10m].grouping().increment() > 0.05","pending":"PT5M","severity":"ERROR","runbook":"object-storage-outage","recovery":"stable for fifteen minutes","maintenanceAllowed":true},
    {"id":16,"name":"Staging cleanup overdue","signal":"stagingAge","condition":"oldest age exceeds approved cleanup age plus reviewed grace; high when capacity threatened","pending":"PT5M","severity":"WARNING","runbook":"orphan-staging-cleanup","recovery":"verified owner-module reconciliation","maintenanceAllowed":true},
    {"id":17,"name":"AI provider failures","signal":"provider","query":"notes_workspace_ai_provider_seconds_count[15m]{outcome!=\"success\"}.increment() >= 5 && notes_workspace_ai_provider_seconds_count[15m]{outcome!=\"success\"}.increment() / notes_workspace_ai_provider_seconds_count[15m].increment() > 0.2","pending":"PT1M","severity":"WARNING","runbook":"gemini-outage-or-quota","recovery":"stable for thirty minutes","maintenanceAllowed":false},
    {"id":18,"name":"Gemini free quota danger","signal":"quota","condition":"verified soft-budget ratio over 0.70 warning or 0.85 high OR repeated RESOURCE_EXHAUSTED","pending":"PT5M","severity":"WARNING","runbook":"gemini-outage-or-quota","recovery":"verified reset or approved configuration","maintenanceAllowed":false},
    {"id":19,"name":"TLS expiry or invalidity","signal":"tls","condition":"under twenty one days warning; under seven days high; invalid critical","pending":"PT1M","severity":"WARNING","runbook":"tls-dns","recovery":"external certificate verification","maintenanceAllowed":false},
    {"id":20,"name":"Free capacity danger","signal":"capacity","condition":"any verified free allowance ratio over 0.70 warning or 0.85 high","pending":"PT5M","severity":"WARNING","runbook":"free-capacity-stop-and-review","recovery":"all ratios below 0.65","maintenanceAllowed":false},
    {"id":21,"name":"Backup too old or failed","signal":"backupAge","condition":"restore-rehearsed backup age exceeds explicitly approved interval","pending":"PT5M","severity":"ERROR","runbook":"postgresql-restore","recovery":"authenticated and rehearsed current backup","maintenanceAllowed":true},
    {"id":22,"name":"Metric ingestion absent","signal":"metricHeartbeat","condition":"independent ingestion heartbeat absent five minutes while service probe succeeds","pending":"PT5M","severity":"ERROR","runbook":"agent-iam-ingestion","recovery":"ingestion stable ten minutes","maintenanceAllowed":true},
    {"id":23,"name":"Log ingestion absent or buffer danger","signal":"logHeartbeat","condition":"heartbeat absent fifteen minutes OR bounded local log buffer over cap","pending":"PT15M","severity":"WARNING","runbook":"agent-iam-log-buffer","recovery":"verified ingestion and bounded drain","maintenanceAllowed":true},
    {"id":24,"name":"Security invariant violated","signal":"securityInvariant","condition":"any zero-tolerance violation, not expected rejection","pending":"PT1M","severity":"CRITICAL","runbook":"security-containment","recovery":"containment and independent verified evidence","maintenanceAllowed":false},
    {"id":25,"name":"Public denial failed","signal":"denialInvariant","condition":"any content or media success after committed denial","pending":"PT1M","severity":"CRITICAL","runbook":"public-media-denial-verification","recovery":"anonymous verification after containment","maintenanceAllowed":false},
    {"id":26,"name":"Security email authority violated","signal":"emailInvariant","condition":"any authority or fencing corruption","pending":"PT1M","severity":"CRITICAL","runbook":"stuck-security-email-and-containment","recovery":"halt worker and validate state before recovery","maintenanceAllowed":false},
    {"id":27,"name":"Moderation consequence failed","signal":"moderationInvariant","condition":"terminal enforcement without required logical consequence or session denial","pending":"PT1M","severity":"CRITICAL","runbook":"security-containment","recovery":"owner-module and independent verification","maintenanceAllowed":false}
  ]
}
