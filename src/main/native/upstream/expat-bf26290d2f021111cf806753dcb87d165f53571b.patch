From bf26290d2f021111cf806753dcb87d165f53571b Mon Sep 17 00:00:00 2001
From: Sebastian Pipping <sebastian@pipping.org>
Date: Fri, 6 Nov 2026 19:16:22 +0100
Subject: [PATCH] lib: Resolve needless `else` in `unknown_toUtf16`

---
 expat/lib/xmltok.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/expat/lib/xmltok.c b/expat/lib/xmltok.c
index 2f837acc4c..f4c317f346 100644
--- a/expat/lib/xmltok.c
+++ b/expat/lib/xmltok.c
@@ -1317,8 +1317,8 @@ unknown_toUtf16(const ENCODING *enc, const char **fromP, const char *fromLim,
 
   if ((*toP == toLim) && (*fromP < fromLim))
     return XML_CONVERT_OUTPUT_EXHAUSTED;
-  else
-    return XML_CONVERT_COMPLETED;
+
+  return XML_CONVERT_COMPLETED;
 }
 
 ENCODING *
