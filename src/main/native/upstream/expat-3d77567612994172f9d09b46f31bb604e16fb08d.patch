From 3d77567612994172f9d09b46f31bb604e16fb08d Mon Sep 17 00:00:00 2001
From: Sebastian Pipping <sebastian@pipping.org>
Date: Fri, 6 Nov 2026 18:35:50 +0100
Subject: [PATCH] lib: Reject overread in `unknown_toUtf8` and
 `unknown_toUtf16`

---
 expat/lib/xmltok.c | 16 ++++++++++++----
 1 file changed, 12 insertions(+), 4 deletions(-)

diff --git a/expat/lib/xmltok.c b/expat/lib/xmltok.c
index f4c317f34..8cc03962e 100644
--- a/expat/lib/xmltok.c
+++ b/expat/lib/xmltok.c
@@ -1283,13 +1283,17 @@ unknown_toUtf8(const ENCODING *enc, const char **fromP, const char *fromLim,
     utf8 = uenc->utf8[(unsigned char)**fromP];
     n = *utf8++;
     if (n == 0) {
+      const size_t readLen
+          = (AS_NORMAL_ENCODING(enc)->type[(unsigned char)**fromP]
+             - (BT_LEAD2 - 2));
+      if (readLen > (size_t)(fromLim - *fromP))
+        return XML_CONVERT_INPUT_INCOMPLETE;
       int c = uenc->convert(uenc->userData, *fromP);
       n = XmlUtf8Encode(c, buf);
       if (n > toLim - *toP)
         return XML_CONVERT_OUTPUT_EXHAUSTED;
       utf8 = buf;
-      *fromP += (AS_NORMAL_ENCODING(enc)->type[(unsigned char)**fromP]
-                 - (BT_LEAD2 - 2));
+      *fromP += readLen;
     } else {
       if (n > toLim - *toP)
         return XML_CONVERT_OUTPUT_EXHAUSTED;
@@ -1307,9 +1311,13 @@ unknown_toUtf16(const ENCODING *enc, const char **fromP, const char *fromLim,
   while (*fromP < fromLim && *toP < toLim) {
     unsigned short c = uenc->utf16[(unsigned char)**fromP];
     if (c == 0) {
+      const size_t readLen
+          = (AS_NORMAL_ENCODING(enc)->type[(unsigned char)**fromP]
+             - (BT_LEAD2 - 2));
+      if (readLen > (size_t)(fromLim - *fromP))
+        return XML_CONVERT_INPUT_INCOMPLETE;
       c = (unsigned short)uenc->convert(uenc->userData, *fromP);
-      *fromP += (AS_NORMAL_ENCODING(enc)->type[(unsigned char)**fromP]
-                 - (BT_LEAD2 - 2));
+      *fromP += readLen;
     } else
       (*fromP)++;
     *(*toP)++ = c;
