{
    admin off
    auto_https disable_redirects
    # HTTP-01 issuance needs port 80; TLS and app traffic remain owner-IP restricted.
}
http://{$PREVIEW_HOST} {
    redir https://{$PREVIEW_HOST}{uri} 308
}
https://{$PREVIEW_HOST} {
    @internal path /actuator* /management* /debug* /v3/api-docs* /swagger*
    respond @internal 404
    request_body {
        max_size 27MB
    }
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        -Server
    }
    reverse_proxy app:8080 {
        header_up -Forwarded
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto https
        header_up X-Forwarded-Host {$PREVIEW_HOST}
        header_up Host {$PREVIEW_HOST}
    }
    # No request access log: OAuth query strings, private paths and input stay out.
}
