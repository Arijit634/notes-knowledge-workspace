{
    admin off
    auto_https disable_redirects
    cert_issuer acme {
        dir https://acme-v02.api.letsencrypt.org/directory
    }
    servers {
        protocols h1 h2
        strict_sni_host on
        timeouts {
            read_header 10s
            read_body 2m
            write 5m
            idle 1m
        }
        max_header_size 32KB
    }
    log default {
        # Request errors can embed callback URLs. Retain their status in the
        # sanitized access logger below instead of recording raw error payloads.
        exclude http.log.error
        format filter {
            request delete
            resp_headers delete
            wrap json
        }
    }
    # HTTP-01 issuance needs port 80; TLS and app traffic remain owner-IP restricted.
}
http://{$PREVIEW_HOST} {
    redir https://{$PREVIEW_HOST}{uri} 308
}
https://{$PREVIEW_HOST} {
    log {
        output stdout
        format filter {
            request delete
            resp_headers delete
            wrap json
        }
    }
    @internal path /actuator* /management* /debug* /v3/api-docs* /swagger*
    respond @internal 404
    request_body {
        max_size 27MB
    }
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        -Server
    }
    reverse_proxy app:8080 {
        header_up -Forwarded
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto https
        header_up X-Forwarded-Host {$PREVIEW_HOST}
        header_up Host {$PREVIEW_HOST}
    }
    # Status/duration only: no request object, URI, headers, cookies or payload.
}
