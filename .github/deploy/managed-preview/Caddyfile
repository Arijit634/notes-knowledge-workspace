{
    admin off
    auto_https off
    persist_config off
    log default {
        exclude http.log.error
        format filter {
            request delete
            resp_headers delete
            wrap json
        }
    }
    servers {
        protocols h1 h2
        timeouts {
            read_header 10s
            read_body 2m
            write 2m
            idle 1m
        }
        max_header_size 32KB
    }
}
http://:10000 {
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        Cache-Control no-store
        -Server
    }
    request_body {
        max_size 27MB
    }
    route {
        # Only status, never a generic management proxy or an auth bypass.
        @ready {
            method GET
            path /_preview/ready
        }
        handle @ready {
            rewrite * /actuator/health/readiness
            reverse_proxy 127.0.0.1:8081 {
                header_up -Authorization
                header_up -Cookie
                header_up -Forwarded
                header_up -X-Forwarded-For
                header_up -X-Forwarded-Host
                header_up -X-Forwarded-Proto
            }
        }
        handle {
            @wrong_host not host {$PREVIEW_HOST}
            respond @wrong_host 400
            @internal path /actuator* /management* /debug* /v3/api-docs* /swagger*
            respond @internal 404
            basic_auth {
                preview {$PREVIEW_PASSWORD_HASH}
            }
            reverse_proxy 127.0.0.1:8080 {
                header_up -Authorization
                header_up -Forwarded
                # Conservatively use the transport peer. No claim that an
                # unverified managed proxy header identifies the original user.
                header_up X-Forwarded-For {remote_host}
                header_up X-Forwarded-Proto https
                header_up X-Forwarded-Host {$PREVIEW_HOST}
                header_up Host {$PREVIEW_HOST}
            }
        }
    }
}
